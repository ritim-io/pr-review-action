{
  "name": "ritim-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that reports a pull request's preview deployment to Ritim and comments the performance result.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  }
}
